local wezterm = require 'wezterm'
local config = wezterm.config_builder()

{{- $host := lower .chezmoi.hostname -}}
{{- /* One scale per machine. Tab font stays 1.12x, borders stay in proportion. */ -}}
{{- $font := 12.0 -}}
{{- $frame := 13.4 -}}
{{- $borderX := "6px" -}}
{{- $borderY := "5px" -}}
{{- if eq $host "carbonpad" -}}
{{- $font = 10.0 -}}
{{- $frame = 11.2 -}}
{{- $borderX = "5px" -}}
{{- $borderY = "4px" -}}
{{- end }}
-- {{ $host }}: terminal {{ $font }}, tabs {{ $frame }}. Other hosts use the maulwurf sizes.
local host_font_size = {{ printf "%.1f" $font }}
local host_frame_font_size = {{ printf "%.1f" $frame }}
local host_border_x = '{{ $borderX }}'
local host_border_y = '{{ $borderY }}'

config.automatically_reload_config = true
config.window_close_confirmation = 'NeverPrompt'
-- Wayland/GNOME can't give WezTerm a real Adwaita title bar; put
-- GNOME-style window buttons in the tab bar instead (single chrome).
config.window_decorations = 'INTEGRATED_BUTTONS | RESIZE'
config.integrated_title_button_style = 'Gnome'
config.default_cursor_style = 'BlinkingBar'
config.font = wezterm.font('JetBrains Mono', { weight = 'Bold' })
config.font_size = host_font_size
config.window_background_opacity = 0.88
config.text_background_opacity = 0.65

-- Slightly larger fancy tabs; colors match the navy theme below.
config.window_frame = {
  font = wezterm.font('JetBrains Mono', { weight = 'Bold' }),
  font_size = host_frame_font_size,
  active_titlebar_bg = '#0b1520',
  inactive_titlebar_bg = '#0b1520',
  -- Thin Solarized edge. Style only; Wayland's resize strip is outside this.
  border_left_width = host_border_x,
  border_right_width = host_border_x,
  border_bottom_height = host_border_y,
  border_top_height = '0px',
  border_left_color = '#073642',
  border_right_color = '#073642',
  border_bottom_color = '#073642',
  border_top_color = '#073642',
}

-- Cool blues/cyans to match the nebula; cell bg is navy so the
-- wallpaper still reads through with text_background_opacity.
config.color_scheme = 'Tokyo Night Storm'
config.colors = {
  background = '#0b1520',
  foreground = '#c8d6ea',
  cursor_bg = '#7dcfff',
  cursor_fg = '#0b1520',
  cursor_border = '#7dcfff',
  selection_bg = '#1f4a6e',
  selection_fg = '#e8f1ff',
  tab_bar = {
    background = '#0b1520',
    active_tab = {
      bg_color = '#1f4a6e',
      fg_color = '#e8f1ff',
    },
    inactive_tab = {
      bg_color = '#0f1c2a',
      fg_color = '#8aa0b8',
    },
    inactive_tab_hover = {
      bg_color = '#152838',
      fg_color = '#c8d6ea',
    },
    new_tab = {
      bg_color = '#0b1520',
      fg_color = '#7dcfff',
    },
    new_tab_hover = {
      bg_color = '#1f4a6e',
      fg_color = '#e8f1ff',
    },
  },
}

config.background = {
  {
    source = {
      File = wezterm.config_dir .. '/bg.jpg',
    },
    hsb = {
      hue = 1.0,
      saturation = 1.02,
      brightness = 0.45,
    },
    -- Cover keeps the photo's aspect ratio and crops the overflow.
    -- 100% on both axes stretches the ultrawide image to the window.
    width = 'Cover',
    height = 'Cover',
    horizontal_align = 'Center',
    vertical_align = 'Middle',
    opacity = 0.9,
  },
  {
    -- Solarized base03. Partly transparent so the photo stays, but softer.
    source = {
      Color = '#002b36',
    },
    width = '100%',
    height = '100%',
    opacity = 0.6,
  },
}

return config
