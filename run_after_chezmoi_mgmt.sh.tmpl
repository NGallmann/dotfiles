#!/bin/bash
set -e
# This is used to link the decrypted file to the Repo (and ignoring it) for easy working with that script
# chezmoi does not like symbolic links that can't resolve to a file, it does error-out before evaluating `.chezmoiignore`
# so we need to ONLY create the link if the file does exist (after decryption)
chezmoi_os="{{ .chezmoi.os }}"

test -f "{{ .chezmoi.config.destDir }}/.zshrc.d/05_work.zsh" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.zshrc.d/05_work.zsh" "{{ .chezmoi.config.workingTree }}/dot_zshrc.d/encrypted_05_work_decrypted.zsh"

test -f "{{ .chezmoi.config.destDir }}/.zshrc.d/06_private.zsh" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.zshrc.d/06_private.zsh" "{{ .chezmoi.config.workingTree }}/dot_zshrc.d/encrypted_06_private_decrypted.zsh"

test -f "{{ .chezmoi.config.destDir }}/.zshrc.d/12_git-mgmt_completion.zsh" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.zshrc.d/12_git-mgmt_completion.zsh" "{{ .chezmoi.config.workingTree }}/dot_zshrc.d/encrypted_12_git-mgmt_completion_decrypted.zsh"

test -f "{{ .chezmoi.config.destDir }}/.ssh/config.d/private-config" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.ssh/config.d/private-config" "{{ .chezmoi.config.workingTree }}/private_dot_ssh/config.d/encrypted_private-config_decrypted"

test -f "{{ .chezmoi.config.destDir }}/.ssh/config.d/work-config" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.ssh/config.d/work-config" "{{ .chezmoi.config.workingTree }}/private_dot_ssh/config.d/encrypted_work-config_decrypted"

test -f "{{ .chezmoi.config.destDir }}/.scripts/git-credential-rbw-personal.sh" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.scripts/git-credential-rbw-personal.sh" "{{ .chezmoi.config.workingTree }}/dot_scripts/encrypted_executable_git-credential-rbw-personal_decrypted.sh"

test -f "{{ .chezmoi.config.destDir }}/.scripts/git-mgmt.sh" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.scripts/git-mgmt.sh" "{{ .chezmoi.config.workingTree }}/dot_scripts/encrypted_executable_git-mgmt_decrypted.sh"

test -f "{{ .chezmoi.config.destDir }}/.gitconfig" && \
    ln -sf "{{ .chezmoi.config.destDir }}//.gitconfig" "{{ .chezmoi.config.workingTree }}/encrypted_dot_gitconfig_decrypted"

test -f "{{ .chezmoi.config.destDir }}/.DevOpsTools-personal-conf.yml" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.DevOpsTools-personal-conf.yml" "{{ .chezmoi.config.workingTree }}/encrypted_dot_DevOpsTools-personal-conf_decrypted.yml"

test -f "{{ .chezmoi.config.destDir }}/.config/openfortivpn/m-vpn.conf" && \
    ln -sf "{{ .chezmoi.config.destDir }}//.config/openfortivpn/m-vpn.conf" "{{ .chezmoi.config.workingTree }}/dot_config/private_openfortivpn/encrypted_private_m-vpn_decrypted.conf"

if [ "$chezmoi_os" = "linux" ]; then
    test -f "{{ .chezmoi.config.destDir }}/.config/rbw/config.json" && \
        ln -sf "{{ .chezmoi.config.destDir }}/.config/rbw/config.json" "{{ .chezmoi.config.workingTree }}/dot_config/rbw/encrypted_config_decrypted.json"
fi

if [ "$chezmoi_os" = "darwin" ]; then
    test -f "{{ .chezmoi.config.destDir }}/Library/Application Support/rbw/config.json" && \
        ln -sf "{{ .chezmoi.config.destDir }}/Library/Application Support/rbw/config.json" "{{ .chezmoi.config.workingTree }}/private_Library/private_Application Support/rbw/encrypted_config_decrypted.json"
fi

test -f "{{ .chezmoi.config.destDir }}/.DevOpsTools/skills-repos.conf" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.DevOpsTools/skills-repos.conf" "{{ .chezmoi.config.workingTree }}/dot_DevOpsTools/encrypted_skills-repos_decrypted.conf"

test -f "{{ .chezmoi.config.destDir }}/.ssh/vault/work-signed-cert.pub" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.ssh/vault/work-signed-cert.pub" "{{ .chezmoi.config.workingTree }}/private_dot_ssh/private_vault/encrypted_private_work-signed-cert_decrypted.pub"

test -f "{{ .chezmoi.config.destDir }}/.config/gcx/config.yaml" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.config/gcx/config.yaml" "{{ .chezmoi.config.workingTree }}/dot_config/gcx/encrypted_private_config_decrypted.yaml"

test -f "{{ .chezmoi.config.destDir }}/.mikromcp/routers.yaml" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.mikromcp/routers.yaml" "{{ .chezmoi.config.workingTree }}/dot_mikromcp/encrypted_routers_decrypted.yaml"

test -f "{{ .chezmoi.config.destDir }}/.pi/agent/settings.json" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.pi/agent/settings.json" "{{ .chezmoi.config.workingTree }}/dot_pi/agent/encrypted_settings_decrypted.json"

test -f "{{ .chezmoi.config.destDir }}/.pi/agent/models.json" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.pi/agent/models.json" "{{ .chezmoi.config.workingTree }}/dot_pi/agent/encrypted_private_models_decrypted.json"

test -f "{{ .chezmoi.config.destDir }}/.pi/agent/extensions/bash-secret-env.ts" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.pi/agent/extensions/bash-secret-env.ts" "{{ .chezmoi.config.workingTree }}/dot_pi/agent/extensions/encrypted_bash-secret-env_decrypted.ts"

test -f "{{ .chezmoi.config.destDir }}/.pi/agent/extensions/subagent-model-guard.ts" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.pi/agent/extensions/subagent-model-guard.ts" "{{ .chezmoi.config.workingTree }}/dot_pi/agent/extensions/encrypted_subagent-model-guard_decrypted.ts"

test -f "{{ .chezmoi.config.destDir }}/.pi/agent/extensions/sandbox-bash-failures/index.ts" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.pi/agent/extensions/sandbox-bash-failures/index.ts" "{{ .chezmoi.config.workingTree }}/dot_pi/agent/extensions/sandbox-bash-failures/encrypted_index_decrypted.ts"

test -f "{{ .chezmoi.config.destDir }}/.pi/agent/extensions/sandbox-bash-failures/context.md" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.pi/agent/extensions/sandbox-bash-failures/context.md" "{{ .chezmoi.config.workingTree }}/dot_pi/agent/extensions/sandbox-bash-failures/encrypted_context_decrypted.md"

test -f "{{ .chezmoi.config.destDir }}/.pi/agent/extensions/pi-sandbox/config.json" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.pi/agent/extensions/pi-sandbox/config.json" "{{ .chezmoi.config.workingTree }}/dot_pi/agent/extensions/pi-sandbox/encrypted_config_decrypted.json"

test -f "{{ .chezmoi.config.destDir }}/.pi/agent/extensions/pi-sandbox/config.notes.md" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.pi/agent/extensions/pi-sandbox/config.notes.md" "{{ .chezmoi.config.workingTree }}/dot_pi/agent/extensions/pi-sandbox/encrypted_config.notes_decrypted.md"

test -f "{{ .chezmoi.config.destDir }}/.pi/agent/extensions/pi-permission-system/config.json" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.pi/agent/extensions/pi-permission-system/config.json" "{{ .chezmoi.config.workingTree }}/dot_pi/agent/extensions/pi-permission-system/encrypted_config_decrypted.json"

test -f "{{ .chezmoi.config.destDir }}/.pi/agent/extensions/pi-auto-review/config.json" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.pi/agent/extensions/pi-auto-review/config.json" "{{ .chezmoi.config.workingTree }}/dot_pi/agent/extensions/private_pi-auto-review/encrypted_config_decrypted.json"

# Linking as command
test -d "{{ .chezmoi.config.destDir }}/.local/bin" || \
    mkdir -p "{{ .chezmoi.config.destDir }}/.local/bin"

test -f "{{ .chezmoi.config.destDir }}/.scripts/git-credential-rbw-personal.sh" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.scripts/git-credential-rbw-personal.sh" "{{ .chezmoi.config.destDir }}/.local/bin/git-credential-rbw-personal"

test -f "{{ .chezmoi.config.destDir }}/.scripts/git-credential-rbw.sh" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.scripts/git-credential-rbw.sh" "{{ .chezmoi.config.destDir }}/.local/bin/git-credential-rbw"

test -f "{{ .chezmoi.config.destDir }}/.scripts/git-mgmt.sh" && \
    ln -sf "{{ .chezmoi.config.destDir }}/.scripts/git-mgmt.sh" "{{ .chezmoi.config.destDir }}/.local/bin/git-mgmt"
